# Public site URL, used for SEO, emails and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production. Any long random string (16+ characters).
# In local development a built-in fallback is used if this is empty.
AUTH_SECRET=

# Owner sign-in password when Supabase Auth is not configured.
# In local development the password is spotless-demo if this is empty.
# Never leave the development password in place on a public server.
ADMIN_PASSWORD=

# Supabase (optional). When all three are set, content and leads are stored
# in Postgres and admin sign-in uses Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional). Leads are still saved if email sending fails.
RESEND_API_KEY=
EMAIL_FROM="Spotless NT <onboarding@resend.dev>"
